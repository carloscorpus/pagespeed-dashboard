# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local al repositorio.

# Obligatoria: key de la API de Google PageSpeed Insights v5.
PSI_API_KEY=

# Opcionales: límite de peticiones por IP (los valores que ves son los de por defecto).
# RATE_LIMIT_PSI=600
# RATE_LIMIT_SITEMAP=30
# RATE_LIMIT_WINDOW_MIN=10
